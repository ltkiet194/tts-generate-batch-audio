# Copy this file to .env and edit values before starting the server.
# Existing process/global environment variables take precedence over .env.

# WAV cache: true to reuse matching audio, false to synthesize each request.
TTS_CACHE_ENABLED=false
TTS_CACHE_MAX_MB=1024

# Optional model/runtime settings:
# TTS_DEVICE=auto
# TTS_MODEL_ID=kjanh/KhanhTTS-OmniVoice
# TTS_MODEL_REVISION=main
# TTS_REQUEST_TIMEOUT_SECONDS=120
