# Put generated WAV files on Google Drive so they survive a Colab disconnect.
TTS_DEVICE=cuda:0
TTS_MODEL_ID=kjanh/KhanhTTS-OmniVoice
TTS_MODEL_REVISION=main
TTS_MODEL_SAMPLE_RATE=24000
TTS_OUTPUT_SAMPLE_RATE=24000
TTS_MAX_TEXT_LENGTH=2000
TTS_DEFAULT_CHARACTER=default

# Fast ephemeral model cache. Change to a Drive path to avoid downloading next session.
TTS_MODEL_CACHE_DIR=/content/model-cache

# Paths may be absolute or relative to this project.
TTS_CHARACTERS_FILE=characters.json
TTS_BATCH_INPUT=dialogues.csv
TTS_BATCH_OUTPUT_DIR=/content/drive/MyDrive/WanderingSwordVoice/generated_audio
TTS_BATCH_CHECKPOINT_EVERY=10
